# Copy to .env and fill in. Read by both the Go API and the SvelteKit app.
ANTHROPIC_API_KEY=
# Shared secret between SvelteKit and Go: any long random string.
INTERNAL_TOKEN=
DATABASE_URL=postgres://localhost/teaching_assistant?sslmode=disable
# Password for "Log in as instructor", which opens the teacher dashboard.
INSTRUCTOR_PASSWORD=
# Claude model the assistant uses; defaults to claude-haiku-5-5.
MODEL=
